#!/usr/bin/env python3
"""Set a numbered list into a box on a transparent canvas, in the
michaelgreenly.dev display style.

    list out.png --box 900x1150 \\
      -t 'gather' -t '*build*' -t 'verify'

This is the alternative to `headline` for the frames where the copy is a set of
things rather than a sentence. It occupies the same layer, takes the same box,
writes the same kind of PNG, and dumps the same kind of layout, so `compose` and
`layered` cannot tell the difference.

Each -t is one row. Rows are never rebroken and never wrapped: a list's line
breaks are the items themselves, which is the one place this differs from
`headline`, where the breaks are ours to choose.

The markers are zero-padded and set in IBM Plex Mono at #18181B, the same value
as the label text, so the column reads as a code listing's line numbers rather
than as five separate colored badges. They are structure, not content, and they
are set at 0.8 of the label size to say so. The accent blue is therefore still
free, and an earmuffed row spends it:

    -t 'gather' -t '*build*' -t 'verify'

sets `02 build` in Space Grotesk Bold blue and leaves the other two black, which
is how a thumbnail says "five steps, and this is the one the video is about".

Numbering is the tool's, not the copy's. Write the items and nothing else; the
markers count from --start (1 by default) and cannot fall out of step with the
rows. --start covers the only case where the numbers should legitimately differ
from the row order, a thumbnail that carries steps three through five of a
series.

No type is measured or drawn here. `headline` is loaded as a module and its
measurer, its placement arithmetic, its layout records and its shadow do all the
work, because there is one text engine in this tree and this is not it. `banner`
shells out to `headline` instead; a list cannot, because the two columns share
one solved pointsize and one set of baselines, and neither survives a process
boundary.
"""

import argparse
import importlib.util
import json
import math
import os
import re
import sys
import tempfile
from importlib.machinery import SourceFileLoader
from types import SimpleNamespace

BIN = os.path.dirname(os.path.abspath(__file__))


def _engine():
    """`bin/headline` as a module.

    It has no .py extension, so the loader has to be named explicitly rather
    than inferred from the suffix. Everything in it is defined at import time
    and `main()` is guarded, so importing runs no CLI.
    """
    loader = SourceFileLoader("headline_engine", os.path.join(BIN, "headline"))
    spec = importlib.util.spec_from_loader(loader.name, loader)
    module = importlib.util.module_from_spec(spec)
    loader.exec_module(module)
    return module


engine = _engine()

# Row advance as a multiple of the solved pointsize. `headline` sets 1.05, which
# is the site's display leading and correct for a sentence broken over lines. A
# list is a set of separate things and wants air between them instead.
LINE_HEIGHT = 1.4

# Distance from the block's left edge to the labels' left edge, as a multiple of
# the pointsize. Everything here is expressed against the type rather than
# against the canvas, so `thumblayout` stays the only file that knows a
# coordinate.
# Two mono digits at MARKER_SCALE advance about 0.96em, and the rest is the gap.
GUTTER_EM = 1.6
# Minimum air between the widest marker and the labels. This only binds once the
# markers reach three digits, where the nominal gutter would no longer clear
# them; below that GUTTER_EM wins and every list has the same gutter.
MARKER_GAP_EM = 0.6

# The markers are set at this fraction of the label size. Mono digits are drawn
# to fill a fixed advance and read larger than the letters beside them, so at
# 1.0 the numbers take the eye first, which is the opposite of what they are for.
MARKER_SCALE = 0.8

# Medium rather than Regular: at 0.8 size against SemiBold labels the lighter cut
# goes thin and loses against a grainy plate.
MARKER_FONT = "IBM-Plex-Mono-Medium"
MARKER_COLOR = "#18181B"  # --color-text, the same value as the label ink

# Markers are zero-padded to at least this many digits, so every row has the
# same advance and the labels line up without being measured against each other.
MARKER_MIN_DIGITS = 2


def die(msg):
    print(f"list: {msg}", file=sys.stderr)
    sys.exit(1)


# ------------------------------------------------------------------- measuring


def marker_texts(count, start):
    """The markers for `count` rows, zero-padded to a common width."""
    last = start + count - 1
    width = max(MARKER_MIN_DIGITS, len(str(last)))
    return [f"{n:0{width}d}" for n in range(start, last + 1)]


def marker_pointsize(pointsize):
    return MARKER_SCALE * pointsize


def gutter_width(markers, marker_m, pointsize):
    """Where the labels start, measured from the block's left edge.

    Nominally GUTTER_EM, widened only if the markers would not otherwise clear
    it. The widest marker decides, not each row's own, so the labels share one
    left edge.
    """
    mp = marker_pointsize(pointsize)
    widest = max(marker_m.line_width([(t, False)], mp) for t in markers)
    return max(GUTTER_EM * pointsize, widest + MARKER_GAP_EM * pointsize)


def block_width(labels, label_m, markers, marker_m, pointsize):
    gutter = gutter_width(markers, marker_m, pointsize)
    return gutter + max(label_m.line_width(s, pointsize) for s in labels)


def solve_pointsize(labels, label_m, markers, marker_m, box_w, box_h,
                    line_height):
    """Largest integer pointsize at which the whole block fits the box.

    The width test includes the gutter, which is itself a multiple of the
    pointsize, so the marker column shrinks with the type instead of eating a
    fixed slice of a box that got smaller.

    The height comes from the label faces alone. The markers are set smaller and
    share the labels' baselines, so they can never be what makes the block too
    tall.
    """

    def fits(p):
        if block_width(labels, label_m, markers, marker_m, p) > box_w:
            return False
        return engine.block_height(labels, p, line_height, label_m) <= box_h

    if not fits(1):
        die(f"box {box_w}x{box_h} is too small for {len(labels)} rows at any size")
    lo, hi = 1, int(box_h) + 1
    while lo < hi:
        mid = (lo + hi + 1) // 2
        if fits(mid):
            lo = mid
        else:
            hi = mid - 1
    return lo


# ------------------------------------------------------------------- rendering


def merge_records(marker_records, label_records, marker_ps, marker_kerning):
    """One line record per row, markers first, then the label.

    `headline`'s dump carries a single pointsize for the whole document because
    a headline has one. A list has two, so the marker segments carry their own
    size and letter spacing and the labels ride on the document's. `layered`
    reads those overrides onto the tspan; anything that does not understand them
    still gets the labels right.
    """
    lines = []
    for markers, labels in zip(marker_records, label_records):
        segments = [
            dict(seg, pointsize=marker_ps, letter_spacing=marker_kerning)
            for seg in markers["segments"]
        ]
        lines.append({
            "baseline": labels["baseline"],
            "segments": segments + labels["segments"],
        })
    return lines


def dump_layout(path, box, pointsize, opts, lines, marker_font):
    doc = {
        "box": {"width": box[0], "height": box[1]},
        "pointsize": pointsize,
        "line_height": opts.line_height,
        "tracking": opts.tracking,
        "letter_spacing": round(opts.tracking * pointsize, 4),
        "stroke": 0,
        "fonts": {
            "body": engine.font_record(opts.font),
            "accent": engine.font_record(opts.accent_font),
            "marker": engine.font_record(marker_font),
        },
        "lines": lines,
    }
    with open(path, "w") as fh:
        json.dump(doc, fh, indent=2)
        fh.write("\n")


# ------------------------------------------------------------------------- cli


def build_parser():
    p = argparse.ArgumentParser(
        prog="list",
        formatter_class=argparse.RawDescriptionHelpFormatter,
        description="Set a numbered list into a box on a transparent canvas, "
                    "in the michaelgreenly.dev display style.",
        epilog=(
            "Each -t is one row, in order, set exactly as given: a list's line\n"
            "breaks are its items, so nothing is rebroken or wrapped.\n\n"
            "The markers are numbered by the tool, counting from --start. Write\n"
            "the items and nothing else; a number typed into the copy would be\n"
            "set beside the one the tool draws.\n\n"
            "Wrap a word or phrase in asterisks to set it in the accent face and\n"
            "color, exactly as in a headline. The markers are deliberately not\n"
            "blue, so the accent is still free for the one row that matters.\n\n"
            "examples:\n"
            "  list out.png --box 900x1150 -t 'gather' -t '*build*' -t 'verify'\n"
            "  list out.png --box 900x1150 --start 3 -t 'ship' -t 'measure'"
        ),
    )
    p.add_argument("output", help="destination PNG")
    p.add_argument("-t", "--text", action="append", metavar="ITEM",
                   help="one row of the list; repeat in order")
    p.add_argument("--box", required=True, help="canvas size WxH")
    p.add_argument("--start", type=int, default=1, metavar="N",
                   help="number the first row N (default 1)")
    p.add_argument("--align", choices=("left", "center", "right"),
                   default="center",
                   help="horizontal placement of the block in the box "
                        "(default center). Rows are always flush left inside "
                        "the block; centering them individually would break the "
                        "gutter, which is the only thing holding the rows "
                        "together")
    p.add_argument("--valign", choices=("top", "middle", "bottom"),
                   default="middle",
                   help="vertical placement of the block in the box "
                        "(default middle)")
    p.add_argument("--line-height", type=float, default=LINE_HEIGHT,
                   help=f"row advance as a multiple of the pointsize "
                        f"(default {LINE_HEIGHT})")
    p.add_argument("--tracking", type=float, default=engine.TRACKING,
                   help=f"letter spacing in em (default {engine.TRACKING})")
    p.add_argument("--color", default=engine.COLOR,
                   help=f"label color (default {engine.COLOR})")
    p.add_argument("--accent-color", default=engine.ACCENT_COLOR,
                   help=f"accent color (default {engine.ACCENT_COLOR})")
    p.add_argument("--marker-color", default=MARKER_COLOR,
                   help=f"marker color (default {MARKER_COLOR})")
    p.add_argument("--font", default=engine.FONT,
                   help=f"label body face (default {engine.FONT})")
    p.add_argument("--accent-font", default=engine.ACCENT_FONT,
                   help=f"face for *accented* words (default "
                        f"{engine.ACCENT_FONT})")
    p.add_argument("--marker-font", default=MARKER_FONT,
                   help=f"marker face (default {MARKER_FONT})")
    p.add_argument("--shadow", nargs="?", const="auto", default="auto",
                   metavar="OPACITYxSIGMA+DX+DY",
                   help="drop a shadow behind the type; on by default, scaled "
                        "to the solved pointsize")
    p.add_argument("--no-shadow", action="store_const", const=None,
                   dest="shadow", help="disable the default drop shadow")
    p.add_argument("--shadow-color", default="#000000",
                   help="shadow color (default #000000)")
    p.add_argument("--dump-layout", default=None, metavar="PATH",
                   help="also write the solved type layout to PATH as JSON, so "
                        "`layered` can set the same rows as live text")
    p.add_argument("--show-box", action="store_true",
                   help="report the solved size on stderr")
    p.add_argument("--force", action="store_true",
                   help="overwrite the output if it exists")
    return p


def main():
    parser = build_parser()
    parser._negative_number_matcher = re.compile(r"^-\.?\d")
    args = parser.parse_args()

    if not args.text:
        die("at least one -t/--text row is required")
    for raw in args.text:
        if engine.ESCAPE_RE.search(raw):
            die(f"row contains an ImageMagick escape sequence: {raw!r}; "
                "a '%' followed by a letter or '[' would be expanded")
        if raw.startswith("@"):
            die(f"row must not start with '@': {raw!r}; ImageMagick reads it "
                "as a file")

    if os.path.splitext(args.output)[1].lower() in engine.OPAQUE_SUFFIXES:
        die(f"output {args.output!r} has no alpha channel; the canvas is "
            "transparent, so write a PNG")
    if os.path.exists(args.output) and not args.force:
        die(f"output exists (use --force to overwrite): {args.output!r}")
    if args.dump_layout and os.path.abspath(args.dump_layout) == os.path.abspath(
            args.output):
        die("--dump-layout and the output are the same file; the layout "
            "describes the PNG, it does not replace it")
    if args.dump_layout and os.path.exists(args.dump_layout) and not args.force:
        die(f"--dump-layout target exists (use --force to overwrite): "
            f"{args.dump_layout!r}")

    if args.line_height <= 0:
        die(f"--line-height must be positive, got {args.line_height}")
    if args.start < 0:
        die(f"--start must not be negative, got {args.start}")

    args.font = engine.resolve_font(args.font)
    args.accent_font = engine.resolve_font(args.accent_font)
    args.marker_font = engine.resolve_font(args.marker_font)

    box_w, box_h = engine.parse_box(args.box)

    labels = [engine.parse_line(raw) for raw in args.text]
    for raw, segments in zip(args.text, labels):
        if not segments:
            die(f"empty row: {raw!r}")

    markers = marker_texts(len(labels), args.start)
    marker_lines = [[(t, False)] for t in markers]

    label_m = engine.Measurer(args.font, args.accent_font, args.tracking)
    marker_m = engine.Measurer(args.marker_font, args.marker_font, args.tracking)

    # The same slack `headline` leaves: a pixel for glyphs that paint a hair
    # past their advance width. Nothing here strokes, so that is the whole pad.
    pad = 1
    inner_w = max(box_w - 2 * pad, 1)
    inner_h = max(box_h - 2 * pad, 1)

    pointsize = solve_pointsize(labels, label_m, markers, marker_m,
                                inner_w, inner_h, args.line_height)
    marker_ps = marker_pointsize(pointsize)
    gutter = gutter_width(markers, marker_m, pointsize)

    widths = [label_m.line_width(s, pointsize) for s in labels]
    block_w = gutter + max(widths)
    block_h = engine.block_height(labels, pointsize, args.line_height, label_m)

    x0 = pad + engine.align_offset(block_w, inner_w, args.align)
    y0 = pad + engine.align_offset(block_h, inner_h, args.valign)
    ascent, _ = label_m.face(pointsize)
    advance = round(args.line_height * pointsize)
    baselines = [y0 + ascent + i * advance for i in range(len(labels))]

    marker_x = x0
    label_x = x0 + gutter

    label_opts = SimpleNamespace(color=args.color, accent_color=args.accent_color,
                                 stroke=0.0)
    marker_opts = SimpleNamespace(color=args.marker_color,
                                  accent_color=args.marker_color, stroke=0.0)

    if args.show_box:
        print(f"list: box {box_w}x{box_h} block "
              f"{int(math.ceil(block_w))}x{int(math.ceil(block_h))} "
              f"pointsize {pointsize} rows {len(labels)}", file=sys.stderr)

    with tempfile.TemporaryDirectory(prefix="list.") as work:
        # One canvas, one invocation: both columns are drawn by the same engine
        # at the same baselines, so there is nothing to composite and nothing
        # that can drift between them.
        magick = ["magick", "-size", f"{box_w}x{box_h}", "xc:none"]
        for i, segments in enumerate(labels):
            magick += engine.annotate_args(marker_lines[i], marker_x,
                                           baselines[i], marker_ps,
                                           marker_opts, marker_m)
            magick += engine.annotate_args(segments, label_x, baselines[i],
                                           pointsize, label_opts, label_m)
        block = os.path.join(work, "block.png")
        engine.run(magick + [block])

        if args.dump_layout:
            placements = [(label_x, b) for b in baselines]
            label_records = engine.layout_records(labels, placements, pointsize,
                                                  label_opts, label_m)
            marker_records = engine.layout_records(
                marker_lines, [(marker_x, b) for b in baselines], marker_ps,
                marker_opts, marker_m)
            lines = merge_records(marker_records, label_records, marker_ps,
                                  round(marker_m.kerning(marker_ps), 4))
            dump_opts = SimpleNamespace(line_height=args.line_height,
                                        tracking=args.tracking,
                                        font=args.font,
                                        accent_font=args.accent_font)
            dump_layout(args.dump_layout, (box_w, box_h), pointsize, dump_opts,
                        lines, args.marker_font)

        if args.shadow is not None:
            block = engine.apply_shadow(block, box_w, box_h, args.shadow,
                                        args.shadow_color, pointsize, work)

        engine.run(["magick", block, args.output])


if __name__ == "__main__":
    main()
